{
  "name": "planetforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "perf": "esbuild scripts/perf/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.perf/bench.mjs --log-level=warning && node node_modules/.perf/bench.mjs",
    "perf:fingerprint": "esbuild scripts/perf/fingerprint.ts --bundle --platform=node --format=esm --outfile=node_modules/.perf/fingerprint.mjs --log-level=warning && node node_modules/.perf/fingerprint.mjs",
    "build:functions": "esbuild supabase/functions/game-command/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:jsr:* --outfile=supabase/functions/game-command/dist/index.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.45.4",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
